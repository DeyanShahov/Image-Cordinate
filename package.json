{
  "name": "image-coordinate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Geotagging camera PWA - take a photo with your phone's browser and see the GPS coordinates where it was taken.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "piexif-ts": "^2.1.0"
  },
  "devDependencies": {
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
